# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die .env-Datei NIE committen (steht in .gitignore).
ANTHROPIC_API_KEY=sk-ant-dein-schluessel-hier

# Supabase. Werte aus Supabase -> Project Settings -> API.
# anon-Key ist öffentlich (KEIN Geheimnis); der SERVICE-Key ist GEHEIM wie ein
# Passwort — nur hier / als Netlify-Env, NIEMALS ins Frontend oder nach Git!
# Der Server (Functions) braucht den Service-Key, um firmen/scan_jobs zu lesen,
# seit RLS den anonymen Zugriff sperrt (siehe migration-m0.sql).
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY=dein-anon-oder-publishable-key
SUPABASE_SERVICE_KEY=dein-service-role-key

# Gemini (Charakter-Bilder, Milestone 6). GEHEIM. Key von https://aistudio.google.com
# (Google AI Studio -> "Get API key"). Ohne den Key meldet die Charakter-Erstellung
# im Onboarding sauber "noch nicht eingerichtet" — alles andere läuft normal.
GEMINI_API_KEY=dein-google-ai-key

# Stripe (vier Plaene). Alle Werte hier sind GEHEIM. Ohne SECRET_KEY und
# mindestens einen Monatspreis antwortet /.netlify/functions/abo-checkout mit
# 501 "Bezahlung ist noch nicht eingerichtet". Werte aus dem Stripe-Dashboard.
STRIPE_SECRET_KEY=sk_test_dein-schluessel
STRIPE_WEBHOOK_SECRET=whsec_dein-webhook-secret

# Je Plan ZWEI Preise am selben Stripe-Produkt: monatlich und jaehrlich.
# Die Betraege stehen woertlich in public/preis.html — beim Aendern beide
# Stellen anfassen.
#   Start  CHF 29/Monat    bzw. CHF 24/Monat jaehrlich  = CHF 288/Jahr
#   Grow   CHF 79/Monat    bzw. CHF 66/Monat jaehrlich  = CHF 792/Jahr
#   Scale  CHF 199/Monat   bzw. CHF 166/Monat jaehrlich = CHF 1992/Jahr
#
# Fehlt ein JAHRESPREIS, schlaegt der Kauf mit einer klaren Meldung fehl.
# Es gibt bewusst keinen Rueckfall auf den Monatspreis: Wer CHF 66 gelesen
# hat, darf nicht CHF 79 belastet werden.
STRIPE_PREIS_START=price_...
STRIPE_PREIS_START_JAHR=price_...
STRIPE_PREIS_GROW=price_...
STRIPE_PREIS_GROW_JAHR=price_...
STRIPE_PREIS_SCALE=price_...
STRIPE_PREIS_SCALE_JAHR=price_...

# Alte Namen aus der Zeit vor Free/Start/Grow/Scale. Sie gelten weiterhin als
# Rueckfall (BASIS -> start, PLUS -> grow), damit ein bereits eingerichtetes
# Deployment beim naechsten Deploy nicht stumm die Bezahlung verliert.
# STRIPE_PREIS_BASIS=
# STRIPE_PREIS_PLUS=

# ── Clerk: serverseitige Anmeldung (PFLICHT in Produktion) ──────────────────
# Die Netlify Functions pruefen das Clerk-Token seit lib/anmeldung.js selbst.
# OHNE DIESE VARIABLE LEHNEN SIE JEDE ANGEMELDETE ANFRAGE AB — Abo, Kundenportal,
# Charakter-Generierung, Dokumente lesen, voller Scan. Das ist Absicht
# (fail-closed): Fail-open waere genau das Loch, das damit geschlossen wurde.
#
# Der Wert steckt im Publishable Key (public/lib/clerk-config.js): der Teil nach
# "pk_test_" bzw. "pk_live_" ist base64 und ergibt die Domain. Fehlt die
# Variable, wird sie aus CLERK_PUBLISHABLE_KEY abgeleitet, sofern die gesetzt ist.
CLERK_ISSUER=https://loyal-marmot-61.clerk.accounts.dev
# CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Kostendeckel ueber die GANZE Plattform ──────────────────────────────────
# Antworten pro TAG ueber ALLE Firmen zusammen (lib/verbrauch.js). Die Zaehlung
# je Firma schuetzt den einzelnen Kunden — nicht die Summe.
# 4000 x CHF 0,0036 = rund CHF 14 am Tag. Ohne Angabe gilt genau dieser Wert.
# Anheben geht ohne Deploy. Aber erst nachsehen, WARUM der Deckel greift.
# PLATTFORM_TAGESDECKEL=4000

# ── Bot-Schutz der Probefahrt (Cloudflare Turnstile) ────────────────────────
# Die Probefahrt ist die einzige Stelle, an der ein Fremder OHNE Konto Geld
# kostet. Ohne diesen Wert laeuft sie ungeschuetzt weiter (fail-open, mit einer
# Warnung im Log) — ein halb eingerichteter Schutz soll das Schaufenster nicht
# schliessen. Der Site Key gehoert nach public/probe.html (data-sitekey).
# TURNSTILE_SECRET=0x...

# ── Aufbewahrungsfristen (lib/aufbewahrung.js) ──────────────────────────────
# Ohne Angabe gelten 90 bzw. 365 Tage. ACHTUNG: Diese Zahlen stehen auch in
# public/datenschutz.html. Wer eine aendert, aendert beide — eine Erklaerung,
# die 90 Tage verspricht, waehrend die Datenbank alles behaelt, ist eine
# nachweisbar falsche Angabe.
# FRIST_GESPRAECHE_TAGE=90
# FRIST_KONTAKTE_TAGE=365
